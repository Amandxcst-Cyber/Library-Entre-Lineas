{
  "name": "amanda-entre-lineas",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:db": "node --import tsx tests/database.test.ts",
    "test:validation": "node --import tsx tests/validation.test.ts",
    "test": "npm run test:validation && npm run test:db && npm run test:discovery",
    "format": "prettier --write app components lib tests proxy.ts next.config.ts package.json README.md",
    "format:check": "prettier --check app components lib tests proxy.ts next.config.ts package.json README.md",
    "test:discovery": "node --import tsx tests/book-discovery.test.ts",
    "test:fixture": "node --import tsx tests/support/supabase-fixture.ts",
    "test:browser-discovery": "node tests/browser-discovery.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "cheerio": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
